---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET,
  useCdn: false, 
  apiVersion: '2024-01-01', 
});

// Geen [0...3] limiet hier, we halen gewoon álles op
const berichten = await client.fetch(`*[_type == "nieuws"] | order(datum desc) {
  _id,
  titel,
  datum,
  inhoud,
  "imageUrl": afbeelding.asset->url
}`);
---

<Layout>
  <h1 class="text-4xl font-bold text-purple-800 mb-6 border-b-4 border-lime-500 pb-2 inline-block">
    Nieuwsoverzicht
  </h1>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
    {berichten.length === 0 ? (
      <p class="text-gray-500 italic">Er zijn nog geen nieuwsberichten toegevoegd.</p>
    ) : (
      berichten.map((bericht) => (
        <article class="bg-gray-50 p-6 rounded-lg border border-gray-200 shadow-sm flex flex-col">
          {bericht.imageUrl && (
            <img 
              src={bericht.imageUrl} 
              alt={bericht.titel} 
              class="w-full h-48 object-cover rounded-md mb-4"
            />
          )}
          <h2 class="text-xl font-bold text-gray-900 mb-2">{bericht.titel}</h2>
          {bericht.datum && (
            <p class="text-sm text-lime-700 font-bold mb-3">
              {new Date(bericht.datum).toLocaleDateString('nl-BE')}
            </p>
          )}
          <p class="text-gray-700 line-clamp-3 mb-4 flex-grow">
            {bericht.inhoud}
          </p>
          <a href={`/nieuws/${bericht._id}`} class="inline-block bg-purple-800 text-white px-4 py-2 rounded font-bold hover:bg-purple-900 transition-colors text-center">
            Lees meer
          </a>
        </article>
      ))
    )}
  </div>
</Layout>