---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET,
  useCdn: false,
  apiVersion: '2024-01-01',
});

const berichten = await client.fetch(`*[_type == "nieuws"] | order(datum desc)[0...3] {
_id,
  titel,
  datum,
  inhoud,
  "imageUrl": afbeelding.asset->url
}`);

const formatDatum = (d: string) =>
  new Date(d).toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Teledienst - Een hart voor mensen">
  <!-- Hero: links de boodschap, rechts meteen de praktische info -->
  <section class="grid gap-12 pb-16 pt-4 md:grid-cols-12 md:pt-10">
    <div class="md:col-span-7">
      <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight text-brand-ink md:text-6xl">
        Een hart voor mensen in Menen.
      </h1>
      <p class="mt-6 max-w-xl text-xl leading-relaxed text-brand-ink/80">
        VZW Teledienst staat mensen met beperkte middelen bij met een luisterend oor en
        praktische hulp, zoals onze televestiaire.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="/doneren"
          class="rounded-md bg-brand-lime px-6 py-3 font-semibold text-brand-ink transition-colors hover:bg-brand-lime-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple"
        >
          Steun ons
        </a>
        <a
          href="/onze-werking"
          class="font-semibold text-brand-purple underline decoration-brand-lime decoration-2 underline-offset-4 hover:decoration-brand-purple focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-purple"
        >
          Bekijk onze werking
        </a>
      </div>
    </div>

    <aside class="md:col-span-5">
      <div class="rounded-xl bg-brand-tint p-8">
        <h2 class="font-display text-2xl font-bold text-brand-purple">Kom langs</h2>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-sm font-semibold text-brand-ink/60">Adres</dt>
            <dd class="mt-0.5 text-lg">Stationsstraat 88, Menen</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-brand-ink/60">Open</dt>
            <dd class="mt-0.5 text-lg">Maandag tot vrijdag, 09:00 &ndash; 12:00</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-brand-ink/60">Telefoon</dt>
            <dd class="mt-0.5 text-lg">
              <a href="tel:012345678" class="underline decoration-brand-lime decoration-2 underline-offset-4 hover:decoration-brand-purple">
                012 34 56 78
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </section>

  <!-- Wat doen we -->
  <section class="grid gap-10 border-t border-brand-ink/10 py-16 md:grid-cols-12">
    <h2 class="font-display text-3xl font-bold text-brand-ink md:col-span-4">Wat doen we?</h2>
    <p class="max-w-2xl text-xl leading-relaxed text-brand-ink/80 md:col-span-8">
      VZW Teledienst zet zich in voor mensen met beperkte middelen. Via onze verschillende
      initiatieven proberen we armoede aan te pakken en mensen terug in hun kracht te zetten.
    </p>
  </section>

  <!-- Nieuws: lijst in plaats van kaarten -->
  <section class="border-t border-brand-ink/10 py-16">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="font-display text-3xl font-bold text-brand-ink">Laatste nieuws</h2>
      <a
        href="/nieuws"
        class="font-semibold text-brand-purple underline decoration-brand-lime decoration-2 underline-offset-4 hover:decoration-brand-purple"
      >
        Alle nieuws
      </a>
    </div>

    {berichten.length === 0 ? (
      <p class="mt-10 text-lg text-brand-ink/70">Er zijn nog geen nieuwsberichten toegevoegd.</p>
    ) : (
      <ul class="mt-10 divide-y divide-brand-ink/10 border-y border-brand-ink/10">
        {berichten.map((bericht) => (
          <li class="grid gap-3 py-8 md:grid-cols-[10rem_1fr_9rem] md:gap-10">
            <div class="text-sm font-semibold text-brand-purple md:pt-1.5">
              {bericht.datum && <time datetime={bericht.datum}>{formatDatum(bericht.datum)}</time>}
            </div>
            <div>
              <h3 class="font-display text-2xl font-bold">
                <a
                  href={`/nieuws/${bericht._id}`}
                  class="hover:text-brand-purple focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-purple"
                >
                  {bericht.titel}
                </a>
              </h3>
              {bericht.inhoud && (
                <p class="mt-2 max-w-2xl line-clamp-2 text-lg leading-relaxed text-brand-ink/75">
                  {bericht.inhoud}
                </p>
              )}
            </div>
            {bericht.imageUrl && (
              <img
                src={bericht.imageUrl}
                alt=""
                class="aspect-[4/3] w-full rounded-lg object-cover md:order-none"
                loading="lazy"
              />
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- Afsluiter: hier krijgt het paars zijn grote moment -->
  <section class="pb-4">
    <div class="flex flex-col items-start justify-between gap-8 rounded-2xl bg-brand-purple px-8 py-12 md:flex-row md:items-center md:px-14">
      <div class="max-w-xl">
        <h2 class="font-display text-3xl font-bold text-white">Help ons mensen terug in hun kracht te zetten.</h2>
        <p class="mt-3 text-lg text-white/80">
          Elke gift, hoe klein ook, gaat naar concrete hulp in Menen.
        </p>
      </div>
      <a
        href="/doneren"
        class="shrink-0 rounded-md bg-brand-lime px-6 py-3 font-semibold text-brand-ink transition-colors hover:bg-brand-lime-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Steun ons
      </a>
    </div>
  </section>
</Layout>