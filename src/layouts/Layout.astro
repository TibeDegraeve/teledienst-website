---
import '../styles/global.css';
// src/layouts/Layout.astro
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VZW Teledienst</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans flex flex-col min-h-screen">
    
    <!-- Navigatiebalk in de juiste huisstijl -->
    <header class="bg-white p-6 shadow-sm border-b-4 border-lime-500">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <!-- Het logo met gesplitste kleuren zoals op de gevel -->
        <a href="/" class="text-3xl font-bold tracking-tight">
          <span class="text-lime-500">tele</span><span class="text-purple-800">dienst</span>
        </a>
        <nav class="space-x-4 font-medium text-gray-600">
          <a href="/" class="hover:text-purple-800 transition-colors">Home</a>
          <a href="/nieuws" class="text-gray-700 hover:text-purple-800 font-medium">Nieuws</a>
          <a href="/onze-werking" class="hover:text-purple-800 transition-colors">Onze werking</a>
          <a href="/doneren" class="bg-lime-500 text-white px-4 py-2 rounded font-bold hover:bg-lime-600 transition-colors">Steun ons</a>
          <a href="/contact" class="hover:text-purple-800 transition-colors">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Hier wordt de unieke inhoud van elke pagina ingeladen -->
    <main class="max-w-4xl mx-auto p-6 mt-8 bg-white shadow-sm rounded-lg flex-grow w-full">
      <slot /> 
    </main>

    <!-- Footer -->
    <footer class="bg-purple-900 text-white text-center p-4 mt-8">
      <p>&copy; {new Date().getFullYear()} VZW Teledienst. Alle rechten voorbehouden.</p>
    </footer>

  </body>
</html>